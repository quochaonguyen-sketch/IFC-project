ADMIN_EMAIL=admin@example.com
# Firebase admin service-account JSON and TURN credentials are optional secrets.
# FIREBASE_ADMIN_JSON=...
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
# Cloudflare TURN: the Worker generates short-lived credentials for browsers.
# TURN_KEY_ID=...
# TURN_KEY_API_TOKEN=...
